{
  "layout": {
    "page_size": "a4",
    "page_margin": {
      "mode": "uniform",
      "value": "40pt"
    },
    "page_numbering": {
      "enabled": true,
      "format": "Page {page} of {pages}",
      "align": "right + bottom"
    },
    "text": {
      "font": "DejaVu Sans",
      "size": "10pt"
    }
  },
  "header": {
    "facility_name": "Care Health System",
    "facility_heading": {
      "align": "center",
      "size": "24pt",
      "weight": "bold"
    },
    "divider": {
      "length": "100%",
      "stroke": "mygray"
    },
    "title": {
      "text": "Patient Discharge Summary",
      "size": "15pt"
    },
    "logo": {
      "file_name": "care-black-logo.svg"
    },
    "created_on": {
      "label": "Created on",
      "style": {
        "fill": "mygray",
        "weight": 500
      },
      "date_format": "[day]/[month]/[year]"
    }
  },
  "sections": [
    {
      "source": "patient",
      "is_table": false,
      "enabled": true,
      "options": {
        "title": "Patient Information",
        "fields": [
          "name",
          "last_name",
          "date_of_birth",
          "gender",
          "phone_number"
        ],
        "style": "list"
      }
    },
    {
      "source": "condition",
      "is_table": true,
      "enabled": true,
      "options": {
        "title": "Active Diagnoses",
        "columns": ["diagnosis", "onset", "clinical_status"],
        "filters": {
          "verification_status": ["confirmed", "provisional"]
        }
      }
    },
    {
      "source": "symptom",
      "is_table": true,
      "enabled": true,
      "options": {
        "title": "Symptoms Reported",
        "columns": ["symptom", "onset"]
      }
    },
    {
      "source": "allergy",
      "is_table": true,
      "enabled": true,
      "options": {
        "title": "Allergies & Intolerances",
        "columns": ["allergen", "onset", "criticality"],
        "filters": {
          "criticality": ["high", "low"]
        }
      }
    },
    {
      "source": "observation",
      "is_table": true,
      "enabled": true,
      "options": {
        "title": "Observation Results",
        "columns": ["observation", "value", "date"]
      }
    },
    {
      "source": "medication_request",
      "is_table": true,
      "enabled": true,
      "options": {
        "title": "Medication Requests",
        "columns": ["medication", "value", "date"]
      }
    },
    {
      "source": "care_team",
      "is_table": true,
      "enabled": true,
      "options": {
        "title": "Treating Team",
        "columns": ["name", "role"]
      }
    },
    {
      "source": "file",
      "is_table": true,
      "enabled": true,
      "options": {
        "title": "Attached Files",
        "columns": ["name", "file_type", "created_date", "created_by"]
      }
    },
    {
      "source": "encounter",
      "is_table": false,
      "enabled": true,
      "options": {
        "title": "Discharge Summary Advice",
        "fields": ["discharge_summary_advice"],
        "style": "text"
      }
    }
  ]
}
