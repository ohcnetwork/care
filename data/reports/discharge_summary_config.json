{
  "layout": {
    "page_size": "a4",
    "page_margin": {
      "mode": "uniform",
      "value": "40pt"
    },
    "page_numbering": {
      "enabled": true,
      "format": "1 of 1",
      "align": "right + bottom"
    },
    "text": {
      "font": "DejaVu Sans",
      "size": "10pt"
    }
  },
    "header": {
    "rows": [
      [
        {
          "type": "text",
          "text": "Central Diagnostic Laboratory",
          "size": "24pt",
          "weight": 400,
          "align": "center"
        }
      ],
      [
        {
          "type": "rule",
          "length": "100%"
        }
      ],
      [
        {
          "type": "text",
          "text": "Patient Discharge Summary",
          "size": "15pt",
          "weight": 400
        },
        {
          "type": "image",
          "file_name": "care-black-logo.svg",
          "width": "20%"
        }
      ],
      [
        {
          "type": "datetime",
          "label": "Created on",
          "format": "[day]/[month]/[year]",
          "style": {
            "fill": "mygray",
            "weight": 400
          }
        }
      ],
      [
        {
          "type": "rule",
          "length": "100%"
        }
      ]
    ]
  },
  "sections": [
    {
      "source": "patient",
      "is_table": false,
      "enabled": true,
      "options": {
        "title": "Patient Information",
        "fields": [
          "name",
          "date_of_birth",
          "gender",
          "phone_number"
        ],
        "style": "list"
      }
    },
    {
      "source": "condition",
      "is_table": true,
      "enabled": true,
      "options": {
        "title": "Active Diagnoses",
        "columns": ["diagnosis", "onset", "clinical_status"],
        "filters": {
          "verification_status": ["confirmed", "provisional"]
        }
      }
    },
    {
      "source": "symptom",
      "is_table": true,
      "enabled": true,
      "options": {
        "title": "Symptoms Reported",
        "columns": ["symptom", "onset"]
      }
    },
    {
      "source": "allergy",
      "is_table": true,
      "enabled": true,
      "options": {
        "title": "Allergies & Intolerances",
        "columns": ["allergen", "onset", "criticality"],
        "filters": {
          "criticality": ["high", "low"]
        }
      }
    },
    {
      "source": "observation",
      "is_table": true,
      "enabled": true,
      "options": {
        "title": "Observation Results",
        "columns": ["observation", "value", "date"]
      }
    },
    {
      "source": "medication_request",
      "is_table": true,
      "enabled": true,
      "options": {
        "title": "Medication Requests",
        "columns": ["medication", "value", "date"]
      }
    },
    {
      "source": "care_team",
      "is_table": true,
      "enabled": true,
      "options": {
        "title": "Treating Team",
        "columns": ["name", "role"]
      }
    },
    {
      "source": "file",
      "is_table": true,
      "enabled": true,
      "options": {
        "title": "Attached Files",
        "columns": ["name", "file_type", "created_date", "created_by"]
      }
    },
    {
      "source": "encounter",
      "is_table": false,
      "enabled": true,
      "options": {
        "title": "Discharge Summary Advice",
        "fields": ["discharge_summary_advice"],
        "style": "text"
      }
    },
    {
  "source": "custom-block",
  "is_table": true,
  "enabled": true,
  "options": {
    "title": "Follow-up Schedule",
    "columns": ["Visit Type", "Date", "Location"],
    "rows": [
      ["Initial", "01/05/2025", "OPD"],
      ["Specialist", "15/05/2025", "Cardiology"]
    ]
  }
},{
  "source": "custom-block",
  "is_table": false,
  "enabled": true,
  "options": {
    "title": "Disclaimer",
    "style": "text",
    "text": "This document is confidential and intended solely for the use of the individual or entity to whom they are addressed."
  }
}
,{
  "source": "custom-block",
  "is_table": false,
  "enabled": true,
  "options": {
    "title": "Emergency Contacts",
    "style": "list",
    "fields": [
      {"label": "Primary Contact", "value": "+91-9876543210"},
      {"label": "Ambulance", "value": "102"}
    ]
  }
}

  ]
}
