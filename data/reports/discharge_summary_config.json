{
  "layout": {
    "page_size": "a4",
    "page_margin": {
      "mode": "uniform",
      "value": "40pt"
    },
    "page_numbering": {
      "enabled": true,
      "format": "1 of 1",
      "align": "right + bottom"
    },
    "text": {
      "font": "DejaVu Sans",
      "size": "10pt"
    }
  },
  "header": {
    "rows": [
      [
        {
          "type": "text",
          "text": "Central Diagnostic Laboratory",
          "size": "24pt",
          "weight": 400,
          "align": "center"
        }
      ],
      [
        {
          "type": "rule",
          "length": "100%",
          "stroke": "mygray"
        }
      ],
      [
        {
          "type": "text",
          "text": "Patient Discharge Summary",
          "size": "15pt",
          "weight": 400
        },
        {
          "type": "image",
          "file_name": "care-black-logo.png",
          "url": "https://en.wikipedia.org/static/images/icons/wikipedia.png",
          "width": "20%",
          "align": "right"
        }
      ],
      [
        {
          "type": "datetime",
          "label": "Created on",
          "format": "[day]/[month]/[year]",
          "style": {
            "fill": "mygray",
            "weight": 500
          },
          "align": "right"
        }
      ],
      [
        {
          "type": "rule",
          "length": "100%",
          "stroke": "mygray"
        }
      ]
    ]
  },

  "sections": [
    {
      "source": "patient_info",
      "is_table": false,
      "enabled": true,
      "options": {
        "title": "Patient Information",
        "fields": [
          "name",
          "gender",
          "phone_number",
          "emergency_phone_number",
          "address",
          "permanent_address",
          "pincode",
            "date_of_birth",
          "deceased_datetime",
          "marital_status",
          "blood_group"
        ],
        "style": "list"
      }
    },
    {
      "source": "diagnosis",
      "is_table": true,
      "enabled": true,
      "options": {
        "title": "Diagnoses",
        "columns": [
          "diagnosis",
          "onset",
          "clinical_status",
          "severity",
          "note"
        ]
      }
    },
    {
      "source": "symptoms",
      "is_table": true,
      "enabled": true,
      "options": {
        "title": "Symptoms Reported",
                "columns": [
          "diagnosis",
          "onset",
          "clinical_status",
          "severity",
          "note"
        ]
      }
    },
    {
      "source": "allergy_intolerance",
      "is_table": true,
      "enabled": true,
      "options": {
        "title": "Allergies And Intolerances",
        "columns": [
          "allergen",
          "onset",
          "criticality",
          "clinical_status",
          "criticality",
          "recorded_date",
          "last_occurrence",
          "allergy_intolerance_type",
          "note"
        ]
      }
    },
    {
      "source": "observation",
      "is_table": true,
      "enabled": true,
      "options": {
        "title": "Observation Results",
        "columns": ["observation", "value", "date"]
      }
    },
    {
      "source": "medication_request",
      "is_table": true,
      "enabled": true,
      "options": {
        "title": "Medication Requests",
        "columns": ["medication", "value", "date","subject_type","interpretation"]
      }
    },
    {
      "source": "care_team",
      "is_table": true,
      "enabled": true,
      "options": {
        "title": "Treating Team",
        "columns": ["name", "role"]
      }
    },
    {
      "source": "file_upload",
      "is_table": true,
      "enabled": true,
      "options": {
        "title": "Attached Files",
        "columns": ["name", "file_type", "created_date"],
        "filters": {
          "file_category": ["discharge_summary"]
        }
      }
    },
    {
      "source": "discharge_summary_advice",
      "is_table": false,
      "enabled": true,
      "options": {
        "title": "Discharge Summary Advice",
        "fields": ["discharge_summary_advice"],
        "style": "text"
      }
    },
    {
  "source": "custom_section",
  "is_table": true,
  "enabled": true,
  "options": {
    "title": "Follow-up Schedule",
    "columns": ["Visit Type", "Date", "Location"],
    "rows": [
      ["Initial", "01/05/2025", "OPD"],
      ["Specialist", "15/05/2025", "Cardiology"]
    ]
  }
},{
  "source": "custom_section",
  "is_table": false,
  "enabled": true,
  "options": {
    "title": "Disclaimer",
    "style": "text",
    "text": "This document is confidential and intended solely for the use of the individual or entity to whom they are addressed."
  }
}
,{
  "source": "custom_section",
  "is_table": false,
  "enabled": true,
  "options": {
    "title": "Emergency Contacts",
    "style": "list",
    "fields": [
      {"label": "Primary Contact", "value": "+91-9876543210"},
      {"label": "Ambulance", "value": "102"}
    ]
  }
}

  ]
}
