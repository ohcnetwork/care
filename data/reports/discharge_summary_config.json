{
  "layout": {
    "page_size": "a4",
    "page_margin": {
      "mode": "uniform",
      "value": "40pt"
    },
    "page_numbering": {
      "enabled": true,
      "format": "1 of 1",
      "align": "right + bottom"
    },
    "text": {
      "font": "DejaVu Sans",
      "size": "10pt"
    }
  },
  "header": {
    "rows": [
      {
        "size_ratio": [
          1
        ],
        "columns": [
          {
            "type": "text",
            "text": "Central Diagnostic Laboratory",
            "size": "24pt",
            "weight": 400,
            "align": "center"
          }
        ]
      },
      {
        "size_ratio": [
          1
        ],
        "columns": [
          {
            "type": "rule",
            "length": 100,
            "stroke": "#808080",
            "align": "center"
          }
        ]
      },
      {
        "size_ratio": [
          4,
          2
        ],
        "columns": [
          {
            "type": "text",
            "text": "Patient Discharge Summary",
            "size": "15pt",
            "weight": 400
          },
          {
            "type": "image",
            "file_name": "care-black-logo.svg",
            "url": "https://raw.githubusercontent.com/ohcnetwork/care/refs/heads/develop/care/static/images/logos/black-logo.svg",
            "width": "40%",
            "align": "right"
          }
        ]
      },
      {
        "size_ratio": [
          1
        ],
        "columns": [
          {
            "type": "datetime",
            "label": "Created on",
            "format": "[day]/[month]/[year]",
            "style": {
              "fill": "#808080",
              "weight": 500
            },
            "align": "left"
          }
        ]
      },
      {
        "size_ratio": [
          1
        ],
        "columns": [
          {
            "type": "rule",
            "length": 100,
            "stroke": "#808080",
            "align": "center"
          }
        ]
      }
    ]
  },
  "sections": [
    {
      "source": "patient_info",
      "is_table": false,
      "enabled": true,
      "options": {
        "title": "Patient Information",
        "fields": [
          "name",
          "gender",
          "phone_number",
          "emergency_phone_number",
          "address",
          "permanent_address",
          "pincode",
          "date_of_birth",
          "year_of_birth",
          "deceased_datetime",
          "marital_status",
          "blood_group",
          "age"
        ],
        "style": "list"
      }
    },
    {
      "source": "diagnosis",
      "is_table": true,
      "enabled": true,
      "options": {
        "title": "Diagnoses",
        "columns": [
          "diagnosis",
          "onset",
          "status",
          "verification",
          "severity",
          "note",
          "logged_by"
        ]
      }
    },
    {
      "source": "symptoms",
      "is_table": true,
      "enabled": true,
      "options": {
        "title": "Symptoms Reported",
        "columns": [
          "symptom",
          "onset",
          "status",
          "verification",
          "severity",
          "note",
          "logged_by"
        ]
      }
    },
    {
      "source": "allergy_intolerance",
      "is_table": true,
      "enabled": true,
      "options": {
        "count": 1,
        "title": "Allergies And Intolerances",
        "columns": [
          "allergen",
          "onset",
          "clinical_status",
          "criticality",
          "verification_status",
          "last_occurrence",
          "note",
          "logged_by",
          "type"
        ]
      }
    },
    {
      "source": "observation",
      "is_table": true,
      "enabled": true,
      "options": {
        "title": "Observation Results",
        "columns": ["observation", "value", "date","status",
          "category","subject_type","subject_id","interpretation","logged_by"]
      }
    },
    {
      "source": "medication_request",
      "is_table": true,
      "enabled": true,
      "options": {
        "title": "Medication Requests",
        "columns": ["medication", "instructions", "date","priority","status","logged_by"]
      }
    },
    {
      "source": "care_team",
      "is_table": true,
      "enabled": true,
      "options": {
        "title": "Treating Team",
        "columns": ["name", "role"]
      }
    },
    {
      "source": "file_upload",
      "is_table": true,
      "enabled": true,
      "options": {
        "title": "Attached Files",
        "columns": ["name", "type", "category"],
        "filters": {
          "file_category": ["discharge_summary"]
        }
      }
    },
    {
      "source": "discharge_summary_advice",
      "is_table": false,
      "enabled": true,
      "options": {
        "title": "Discharge Summary Advice",
        "fields": ["discharge_summary_advice"],
        "style": "text"
      }
    },
    {
      "source": "custom_section",
      "is_table": false,
      "enabled": true,
      "options": {
        "title": "Emergency Contacts",
        "style": "list",
        "fields": [
          {"label": "Primary Contact", "value": "+91-9876543210"},
          {"label": "Ambulance", "value": "102"}
        ]
      }
    },
    {
      "source": "custom_section",
      "is_table": false,
      "enabled": true,
      "options": {
        "title": "Disclaimer",
        "style": "text",
        "text": [
          "This document is confidential and intended solely for the use of the individual or entity to whom they are addressed."
        ]
      }
    }



  ]
}
