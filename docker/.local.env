POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=db
POSTGRES_DB=care
POSTGRES_PORT=5432
DATABASE_URL=postgres://postgres:postgres@db:5432/care
REDIS_URL=redis://redis:6379
CELERY_BROKER_URL=redis://redis:6379/0

DJANGO_DEBUG=true
ATTACH_DEBUGGER=false

BUCKET_REGION=ap-south-1
BUCKET_KEY=${MINIO_ACCESS_KEY:-minioadmin}
BUCKET_SECRET=${MINIO_SECRET_KEY:-minioadmin}
BUCKET_ENDPOINT=http://minio:9000
BUCKET_EXTERNAL_ENDPOINT=http://localhost:9100
FILE_UPLOAD_BUCKET=patient-bucket
FACILITY_S3_BUCKET=facility-bucket

BACKEND_DOMAIN="http://localhost:9000/"

# Beckn NFH integration

# Beckn catalog publish identity
BECKN_BPP_ID=cnn_beck_bpp.ohc.network
BECKN_BAP_ID=cnn_beck_bap.ohc.network
BECKN_BPP_CALLER_URL=https://roving-whiny-underpay.ngrok-free.dev/bpp/caller
BECKN_BAP_CALLER_URL=https://onyx.khavinshankar.dev/bap/caller
# URIs = where the REMOTE network POSTS callbacks/actions BACK to Care.
# These MUST be publicly reachable (the remote gateway calls them), so use the
# public ngrok tunnel that points at this Care instance — NOT localhost/docker.
BECKN_BAP_URI=https://onyx.khavinshankar.dev/bap/receiver
BECKN_BPP_URI=https://roving-whiny-underpay.ngrok-free.dev/bpp/receiver
BECKN_CC_BPP_ID=bpp.mdtlabs.org
BECKN_CC_BPP_URI=https://stretch-landed-rare.ngrok-free.dev/bpp/receiver
BECKN_NETWORK_ID=medtroniclabs.org/sandbox_ccn_reference_registry
